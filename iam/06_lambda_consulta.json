{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ResolveUserAndCall",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:${REGION}:${ACCOUNT_ID}:table/${TABLE_IDENTITY_MAP}",
        "arn:aws:dynamodb:${REGION}:${ACCOUNT_ID}:table/${TABLE_CALLS}",
        "arn:aws:dynamodb:${REGION}:${ACCOUNT_ID}:table/${TABLE_QUERY_JOBS}"
      ]
    },
    {
      "Sid": "RegisterAuthorizedQuery",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:${REGION}:${ACCOUNT_ID}:table/${TABLE_QUERY_JOBS}"
    },
    {
      "Sid": "RunApprovedQueries",
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults"
      ],
      "Resource": "arn:aws:athena:${REGION}:${ACCOUNT_ID}:workgroup/${ATHENA_WORKGROUP}"
    },
    {
      "Sid": "ReadCatalog",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetTable",
        "glue:GetPartitions"
      ],
      "Resource": [
        "arn:aws:glue:${REGION}:${ACCOUNT_ID}:catalog",
        "arn:aws:glue:${REGION}:${ACCOUNT_ID}:database/${GLUE_DATABASE}",
        "arn:aws:glue:${REGION}:${ACCOUNT_ID}:table/${GLUE_DATABASE}/calls_*",
        "arn:aws:glue:${REGION}:${ACCOUNT_ID}:table/${GLUE_DATABASE}/terms_*"
      ]
    },
    {
      "Sid": "ReadCuratedData",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::${BUCKET_CURATED}/*"
    },
    {
      "Sid": "InspectQueryBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::${BUCKET_CURATED}",
        "arn:aws:s3:::${BUCKET_QUERY_RESULTS}"
      ]
    },
    {
      "Sid": "ManageQueryResults",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::${BUCKET_QUERY_RESULTS}/*"
    },
    {
      "Sid": "ReadAuthorizedTranscript",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::${BUCKET_TRANSCRIPTS}/*"
    },
    {
      "Sid": "WriteFunctionLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:${REGION}:${ACCOUNT_ID}:log-group:/aws/lambda/${FUNCTION_CONSULTA}:*"
    }
  ]
}
