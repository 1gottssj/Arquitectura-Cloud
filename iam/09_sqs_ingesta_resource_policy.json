{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowOnlyRawBucketNotifications",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:${REGION}:${ACCOUNT_ID}:${QUEUE_INGESTA}",
      "Principal": {
        "Service": "s3.amazonaws.com"
      },
      "Condition": {
        "ArnEquals": {
          "aws:SourceArn": "arn:aws:s3:::${BUCKET_RAW}"
        },
        "StringEquals": {
          "aws:SourceAccount": "${ACCOUNT_ID}"
        }
      }
    }
  ]
}
